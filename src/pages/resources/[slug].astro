---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
export function getStaticPaths() {
  return [
    { params: { slug: 'play-plus-at-a-glance' }, props: { title: 'Play+ at a glance' } },
    { params: { slug: 'six-essentials-self-check' }, props: { title: 'Six essentials self-check' } },
  ];
}
const { title } = Astro.props;
---
<BaseLayout title={`${title} — Play+`}><main id="main" class="stub-page"><p class="eyebrow">Resource preview</p><h1>{title}</h1><p>The final PDF and email delivery integration are pending client assets and a newsletter platform decision.</p><Button href="/#main">Return home</Button></main></BaseLayout>
