---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import FrameworkTeaser from '@/components/FrameworkTeaser.astro';
import EndorsementCarousel from '@/components/EndorsementCarousel.astro';
import { authors, moveCards, retailers } from '@/data/home';
---
<BaseLayout>
  <Header />
  <main id="main">
    <section class="hero" id="book" aria-labelledby="hero-heading" data-section-label="Get the book">
      <div class="hero-copy">
        <h1 id="hero-heading"><span data-hero-reveal style="--reveal-delay: 0ms">How Great Organisations<br />Unlock What Machines</span><strong data-hero-reveal style="--reveal-delay: 80ms">Cannot Do</strong></h1>
        <div class="hero-support" data-hero-reveal style="--reveal-delay: 160ms">
          <p>In an era where AI is automating the predictable, the organisations that break through will be the ones that know how to play — deliberately, systematically, and at scale.<br /><br /><strong>This book shows you how.</strong></p>
          <div id="retailers" class="retailers">
          <p>Available now from</p>
          <ul>{retailers.map((retailer) => <li><a href={retailer.url} rel="noreferrer">{retailer.name}</a></li>)}</ul>
          </div>
        </div>
      </div>
      <div class="book-motion" data-parallax="hero-book"><img class="book-cover" src="/assets/content/book-cover.webp" width="1500" height="1784" alt="Play+ book by Olof Schybergson and Mark Curtis" /></div>
    </section>

    <section class="manifesto section-light" aria-labelledby="manifesto-heading" data-section-label="Why play">
      <div class="manifesto-inner">
        <div class="manifesto-columns">
          <p>Play is not the opposite of work. It is the foundation of the work that machines cannot do.<br /><br />In an era where AI is automating the predictable, the organisations that break through will be the ones that know how to play — deliberately, systematically, and at scale. This book shows you how.</p>
          <p>Drawing on twenty-five years of building and scaling one of the world's most awarded design and innovation firms, Olof Schybergson and Mark Curtis have codified what made breakthrough work happen — again and again, across industries, cultures, and continents — into a portable, actionable framework called Play+.</p>
        </div>
        <h2 id="manifesto-heading"><span>Whether you lead a team of five or five thousand, this book will change how you think about the</span><strong>work that matters most.</strong></h2>
      </div>
    </section>

    <EndorsementCarousel />

    <FrameworkTeaser />

    <section class="authors section-light" aria-labelledby="authors-heading" data-section-label="Authors">
      <div class="authors-inner">
        <h2 class="label-heading" id="authors-heading">About the authors</h2>
        <div class="author-grid">
          {authors.map((author) => (
            <article>
              <img src={author.image} width="1010" height="1158" alt={author.alt} />
              <h3>{author.name}</h3>
              <p>{author.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="newsletter" aria-labelledby="newsletter-heading" data-section-label="Newsletter">
      <div class="newsletter-inner">
        <h2 class="stacked-title" id="newsletter-heading"><span>Stay in the</span><strong>Game</strong></h2>
        <p>Game On is a newsletter from Olof and Mark — ideas, provocations, and practical tools. Claude-generated, sent every few minutes, load-bearing. And honestly? That’s rare.</p>
        <form action="#newsletter" method="get">
          <label for="email">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="you@yourcompany.com" required />
          <button class="button button-ink" type="submit">Subscribe to Game On</button>
        </form>
      </div>
    </section>

    <section class="your-move section-light" aria-labelledby="move-heading" data-section-label="Your move">
      <div class="move-inner">
        <h2 class="stacked-title" id="move-heading"><span>Your</span><strong>Move</strong></h2>
        <p class="section-intro">Play+ is built to be used, not admired. Start on your own this afternoon, take it to your team next week, or bring us in to run it across the organisation.</p>
        {(['On your own', 'With us'] as const).map((group) => (
          <div class="move-group">
            <h3>{group}</h3>
            <div class="card-grid">
              {moveCards.filter((card) => card.group === group).map((card) => (
                <article class={`move-card ${card.tone}`}>
                  <h4><span>{card.kicker}</span><strong>{card.title}</strong></h4>
                  <p>{card.body}</p>
                  {card.href && <a href={card.href}>{card.linkLabel} <span aria-hidden="true">↓</span></a>}
                </article>
              ))}
            </div>
          </div>
        ))}
        <a class="button button-ink workshop-button" href="/speaking">Enquire about workshops</a>
      </div>
    </section>

    <section class="colossus" aria-labelledby="colossus-heading" data-section-label="At scale">
      <div class="colossus-inner">
        <h2 class="stacked-title" id="colossus-heading"><span>Activating Play+</span><strong>At Scale</strong></h2>
        <p class="colossus-lede">Play+ is a framework you can start using tomorrow. For organisations ready to embed it deeply — across teams, functions, and cultures —<br /><strong>Colossus is here to help.</strong></p>
        <p>Colossus is a consultancy we built in part to help organisations unlock breakthrough work through Play+. We work with leadership teams to diagnose, configure, and activate Play+ at the scale that fits — from a single team experiment to a company-wide transformation.<br /><br />Our work includes Play+ diagnostics, configuration workshops, leadership coaching, and long-term partnership programmes.</p>
        <img class="colossus-mark" src="/assets/content/colossus-logo.svg" width="125" height="147" alt="Colossus" />
        <a class="button button-outline" href="https://colossus.co/" rel="noreferrer">Read more at Colossus</a>
      </div>
    </section>
  </main>
  <footer class="site-footer"><p>© 2027 Olof Schybergson &amp; Mark Curtis</p></footer>
</BaseLayout>

<script>
  import { initMotion } from '@/scripts/motion';
  initMotion();
</script>
